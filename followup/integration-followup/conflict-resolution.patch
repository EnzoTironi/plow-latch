-export const WHATSAPP_FALLBACK_SCRIPT =
-  'f=${1##*/}; d=./wa.$$ && mkdir "$d" && cp "$1"* "$d"/ && ' +
-  '/usr/bin/sqlite3 -csv -header "$d/$f" "$2"; rc=$?; rm -rf "$d"; exit $rc';
